{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Fighter",
  "type": "object",
  "required": ["id", "name", "faction", "color", "stats", "body", "previewHeight", "moves", "special", "svg"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "faction": { "type": "string", "minLength": 1 },
    "poses": {
      "description": "Per-character overrides of the default poses; anything omitted uses the defaults.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "idle": { "$ref": "#/definitions/pose" },
        "victory": { "$ref": "#/definitions/pose" },
        "lose": { "$ref": "#/definitions/pose" },
        "jump": { "$ref": "#/definitions/pose" },
        "block": { "$ref": "#/definitions/pose" },
        "hit": { "$ref": "#/definitions/pose" },
        "ko": { "$ref": "#/definitions/pose" },
        "punch": { "$ref": "#/definitions/phasedPose" },
        "kick": { "$ref": "#/definitions/phasedPose" },
        "special": { "$ref": "#/definitions/phasedPose" }
      }
    },
    "previewHeight": { "description": "Height in px used to scale the fighter on the select screen and result card.", "type": "number", "exclusiveMinimum": 0 },
    "taunts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "winQuote": { "type": "string", "minLength": 1 },
    "stats": {
      "type": "object",
      "required": ["maxHealth", "walkSpeed", "jumpVelocity"],
      "additionalProperties": false,
      "properties": {
        "maxHealth": { "type": "number", "exclusiveMinimum": 0 },
        "walkSpeed": { "type": "number", "minimum": 0 },
        "jumpVelocity": { "type": "number", "minimum": 0 }
      }
    },
    "body": {
      "type": "object",
      "required": ["width", "height"],
      "additionalProperties": false,
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "moves": {
      "type": "object",
      "required": ["light", "heavy"],
      "additionalProperties": false,
      "properties": {
        "light": { "$ref": "#/definitions/move" },
        "heavy": { "$ref": "#/definitions/move" }
      }
    },
    "special": { "$ref": "#/definitions/special" },
    "svg": { "$ref": "#/definitions/svg" }
  },
  "definitions": {
    "svg": {
      "description": "Layered SVG art (public/assets/characters). Art-space values use the manifest canvas units; angles are degrees from straight down, forward positive.",
      "type": "object",
      "required": ["id", "scale", "pivots", "propFollows", "anim"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "scale": { "type": "number", "exclusiveMinimum": 0 },
        "pivots": {
          "type": "object",
          "required": ["shoulderBack", "shoulderFront", "hipBack", "hipFront", "neck", "footBack", "footFront"],
          "additionalProperties": { "$ref": "#/definitions/pair" }
        },
        "propFollows": { "enum": ["arm-front", "arm-back", "none"] },
        "anim": {
          "type": "object",
          "required": [
            "restAngles", "elbowWeight", "restElbow", "extendElbow", "reach", "kneeWeight",
            "leanScale", "headScale", "bobScale", "cloth"
          ],
          "additionalProperties": false,
          "properties": {
            "restAngles": {
              "type": "object",
              "required": ["armBack", "armFront", "legBack", "legFront"],
              "additionalProperties": { "type": "number" }
            },
            "elbowWeight": { "type": "number" },
            "restElbow": { "type": "number" },
            "extendElbow": { "type": "number", "exclusiveMinimum": 0 },
            "reach": { "type": "number" },
            "kneeWeight": { "type": "number" },
            "leanScale": { "type": "number" },
            "headScale": { "type": "number" },
            "bobScale": { "type": "number" },
            "cloth": {
              "type": "object",
              "required": ["pivot", "windSwing", "swing", "speed", "lag", "breeze"],
              "additionalProperties": false,
              "properties": {
                "pivot": { "$ref": "#/definitions/pair" },
                "windSwing": { "type": "number" },
                "swing": { "type": "number" },
                "speed": { "type": "number" },
                "lag": { "type": "number", "minimum": 0 },
                "breeze": { "type": "number" }
              }
            }
          }
        }
      }
    },
    "burn": {
      "description": "Damage over time left by an unblocked hit.",
      "type": "object",
      "required": ["damagePerSec", "durationMs"],
      "additionalProperties": false,
      "properties": {
        "damagePerSec": { "type": "number", "minimum": 0 },
        "durationMs": { "type": "number", "minimum": 0 }
      }
    },
    "hex": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "pair": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
    "pose": {
      "description": "Degrees from straight down, forward positive. Arms are [shoulder, elbow]; legs are [hip, knee].",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lean": { "type": "number" },
        "headTilt": { "type": "number" },
        "frontArm": { "$ref": "#/definitions/pair" },
        "backArm": { "$ref": "#/definitions/pair" },
        "frontLeg": { "$ref": "#/definitions/pair" },
        "backLeg": { "$ref": "#/definitions/pair" },
        "bobAmp": { "type": "number", "minimum": 0 },
        "bobSpeed": { "type": "number", "minimum": 0 },
        "sway": { "type": "number", "minimum": 0 }
      }
    },
    "phasedPose": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "startup": { "$ref": "#/definitions/pose" },
        "active": { "$ref": "#/definitions/pose" },
        "recovery": { "$ref": "#/definitions/pose" }
      }
    },
    "hitbox": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "special": {
      "type": "object",
      "required": ["type", "name", "description", "cost", "cooldownMs", "damage", "startupMs", "activeMs", "recoveryMs"],
      "properties": {
        "type": { "enum": ["projectile", "dash", "shield", "stun", "teleport", "summon"] },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "cost": { "type": "number", "minimum": 0, "maximum": 100 },
        "cooldownMs": { "type": "number", "minimum": 0 },
        "damage": { "type": "number", "minimum": 0 },
        "startupMs": { "type": "number", "minimum": 0 },
        "activeMs": { "type": "number", "minimum": 0 },
        "recoveryMs": { "type": "number", "minimum": 0 },
        "hitstunMs": { "type": "number", "minimum": 0 },
        "blockstunMs": { "type": "number", "minimum": 0 },
        "knockback": { "type": "number" },
        "guardBreak": { "type": "boolean" },
        "burn": { "$ref": "#/definitions/burn" },
        "color": { "$ref": "#/definitions/hex" },
        "knockdown": { "type": "boolean", "description": "A clean hit floors the defender for the hitstun." },
        "impact": { "type": "string", "description": "Comic-book word shown on a clean hit." },
        "label": { "type": "string", "description": "Replaces the special-type label on character select." },
        "spinTurns": { "type": "number", "minimum": 0 },
        "spawnFrom": { "enum": ["self", "edge", "opponent"] },
        "pierce": { "type": "boolean" },
        "fx": { "enum": ["constitution", "bulldozer", "cycle", "lathi", "panja", "broom", "mic", "baarish", "jaadu"] },
        "volley": {
          "type": "object",
          "required": ["standOffX", "strikes", "beatMs"],
          "additionalProperties": false,
          "properties": {
            "standOffX": { "type": "number" },
            "strikes": { "type": "integer", "minimum": 1 },
            "beatMs": { "type": "number", "exclusiveMinimum": 0 },
            "vanish": { "type": "boolean" },
            "delayMs": { "type": "number", "minimum": 0 }
          }
        },
        "finisher": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "damage": { "type": "number", "minimum": 0 },
            "hitstunMs": { "type": "number", "minimum": 0 },
            "blockstunMs": { "type": "number", "minimum": 0 },
            "knockback": { "type": "number" },
            "knockdown": { "type": "boolean" },
            "impact": { "type": "string" },
            "burn": { "$ref": "#/definitions/burn" }
          }
        },
        "reflectRatio": { "type": "number", "minimum": 0 },
        "behindOffset": { "type": "number" },
        "offsetX": { "type": "number" },
        "strikeDelayMs": { "type": "number", "minimum": 0 },
        "speed": { "type": "number", "minimum": 0 },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "y": { "type": "number" },
        "spawnX": { "type": "number" },
        "lifetimeMs": { "type": "number", "exclusiveMinimum": 0 },
        "hitbox": { "$ref": "#/definitions/hitbox" },
        "area": {
          "type": "object",
          "required": ["width", "height"],
          "additionalProperties": false,
          "properties": {
            "width": { "type": "number", "exclusiveMinimum": 0 },
            "height": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "projectile" } } },
          "then": {
            "required": ["hitstunMs", "blockstunMs", "knockback", "speed", "width", "height", "y", "spawnX", "lifetimeMs"]
          }
        },
        {
          "if": { "properties": { "type": { "const": "dash" } } },
          "then": { "required": ["hitstunMs", "blockstunMs", "knockback", "speed", "hitbox"] }
        },
        {
          "if": { "properties": { "type": { "const": "stun" } } },
          "then": { "required": ["hitstunMs", "blockstunMs", "knockback", "area"] }
        },
        {
          "if": { "properties": { "type": { "const": "teleport" } } },
          "then": { "required": ["hitstunMs", "blockstunMs", "knockback", "behindOffset", "hitbox"] }
        },
        {
          "if": { "properties": { "type": { "const": "summon" } } },
          "then": {
            "required": [
              "hitstunMs",
              "blockstunMs",
              "knockback",
              "offsetX",
              "width",
              "height",
              "y",
              "strikeDelayMs",
              "lifetimeMs"
            ]
          }
        }
      ]
    },
    "move": {
      "type": "object",
      "required": [
        "startupMs",
        "activeMs",
        "recoveryMs",
        "damage",
        "hitstunMs",
        "blockstunMs",
        "knockback",
        "hitbox"
      ],
      "additionalProperties": false,
      "properties": {
        "startupMs": { "type": "number", "minimum": 0 },
        "activeMs": { "type": "number", "minimum": 0 },
        "recoveryMs": { "type": "number", "minimum": 0 },
        "damage": { "type": "number", "minimum": 0 },
        "hitstunMs": { "type": "number", "minimum": 0 },
        "blockstunMs": { "type": "number", "minimum": 0 },
        "knockback": { "type": "number" },
        "hitbox": {
          "type": "object",
          "required": ["x", "y", "width", "height"],
          "additionalProperties": false,
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "width": { "type": "number", "exclusiveMinimum": 0 },
            "height": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      }
    }
  }
}
